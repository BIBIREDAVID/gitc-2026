VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The site's real public URL, no trailing slash (e.g. https://gitc2026.ng).
# Used in index.html to build absolute og:url / og:image / twitter:image tags
# — required for most link-preview scrapers (WhatsApp, etc). Set this before
# deploying; leave blank for local dev.
VITE_SITE_URL=

# --- Server-side only — never prefix these with VITE_, never put them in
# .env.local, never commit them. Used by scripts/*.js and (for the Edge
# Function secrets) `supabase secrets set`. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same value as VITE_SITE_URL above, server-side — used by send-ticket-email
# to build the link to the ticket page inside the email. Edge Function
# secret only (`supabase secrets set`), not read by the front end.
SITE_URL=

# Gmail SMTP (App Password, not OAuth/a service account — see
# send-ticket-email) — ticket-confirmation email. Both required together;
# missing either (or settings.email_enabled = false) makes it a no-op, per
# the TBA-safe email rule. GMAIL_APP_PASSWORD is a 16-character App Password
# from myaccount.google.com/apppasswords (needs 2-Step Verification turned
# on for the account first) — never the account's real login password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
